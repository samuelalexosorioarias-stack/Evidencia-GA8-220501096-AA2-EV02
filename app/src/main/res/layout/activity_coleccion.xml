<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado de la Pantalla -->
        <TextView
            android:id="@+id/tvTituloColeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COLECCIÓN DE JOYAS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#D4AF37"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvSubtituloColeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Piezas elaboradas en Oro 18K y gemas certificadas"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Divisor Dorado -->
        <View
            android:layout_width="50dp"
            android:layout_height="2dp"
            android:background="#D4AF37"
            android:layout_marginBottom="24dp" />

        <!-- Contenedor del Detalle de Productos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/tvContenidoColeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando productos..."
                android:textColor="#DDDDDD"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp" />
        </LinearLayout>

        <!-- Botón de Acción Principal -->
        <Button
            android:id="@+id/btnSolicitarAsesoria"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SOLICITAR ASESORÍA POR WHATSAPP"
            android:textColor="#121212"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:backgroundTint="#D4AF37"
            android:layout_marginBottom="12dp" />

        <!-- Botón para regresar -->
        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="VOLVER AL MENÚ PRINCIPAL"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:backgroundTint="#2D2D2D" />

    </LinearLayout>
</ScrollView>